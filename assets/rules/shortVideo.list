# Rule list for banning short videos and other unwanted contents
# Some content may not able to load when activate this list
# FOR PERSONAL USR ONLY

# Xiaohongshu
DOMAIN-SUFFIX,fe-static.xhscdn.com
DOMAIN-SUFFIX,crash.xiaohongshu.com
URL-REGEX,^http:\/\/sns-na-.{2}\.xhscdn\.com.*\.mp4$
URL-REGEX,^http:\/\/sns-bak-.{2}\.xhscdn\.com\/stream.*$
DOMAIN-SUFFIX,fe-video-qc.xhscdn.com
URL-REGEX,^https:\/\/mediacloud\.xiaohongshu\.com\/api\/httpdns.*$
URL-REGEX,^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/video_finished.*$
URL-REGEX,^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system_service\/launch.*$
URL-REGEX,^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/note\/widgets$
URL-REGEX,^https:\/\/www\.xiaohongshu\.com\/api\/sns\/v1\/system_service\/popup_window.*$
URL-REGEX,^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/video_played.*$
DOMAIN-SUFFIX,lng.xiaohongshu.com
DOMAIN-SUFFIX,t2.xiaohongshu.com
DOMAIN-SUFFIX,apm-native.xiaohongshu.com
DOMAIN-SUFFIX,sns-video-hs.xhscdn.com
URL-REGEX,^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/metrics_report$
URL-REGEX,^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/videofeed\/exit$
DOMAIN-SUFFIX,sns-video-hw.xhscdn.net
DOMAIN-KEYWORD,sns-video-al.xhscdn.com
DOMAIN-SUFFIX,sns-video-qc.xhscdn.com
DOMAIN-SUFFIX,sns-video-hw.xhscdn.com
DOMAIN-SUFFIX,sns-video-bd.xhscdn.com
DOMAIN-KEYWORD,spider-tracker.xiaohongshu.com
DOMAIN-SUFFIX,sns-video-exp1-qn.xhscdn.com

