# Rule list for banning short videos and other unwanted contents
# Some content may not able to load when activate this list
# FOR PERSONAL USR ONLY

# Xiaohongshu
DOMAIN-SUFFIX,fe-static.xhscdn.com,REJECT-DROP
DOMAIN-SUFFIX,crash.xiaohongshu.com,REJECT-DROP
URL-REGEX,^http:\/\/sns-na-.{2}\.xhscdn\.com.*\.mp4$,REJECT-DROP
URL-REGEX,^http:\/\/sns-bak-.{2}\.xhscdn\.com\/stream.*$,REJECT-DROP
DOMAIN-SUFFIX,fe-video-qc.xhscdn.com,REJECT-DROP
URL-REGEX,^https:\/\/mediacloud\.xiaohongshu\.com\/api\/httpdns.*$,REJECT-DROP
URL-REGEX,^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/video_finished.*$,REJECT-DROP
URL-REGEX,^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/system_service\/launch.*$,REJECT-DROP
URL-REGEX,^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v2\/note\/widgets$,REJECT-DROP
URL-REGEX,^https:\/\/www\.xiaohongshu\.com\/api\/sns\/v1\/system_service\/popup_window.*$,REJECT-DROP
URL-REGEX,^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/video_played.*$,REJECT-DROP
DOMAIN-SUFFIX,lng.xiaohongshu.com,REJECT-DROP
DOMAIN-SUFFIX,t2.xiaohongshu.com,REJECT-DROP
DOMAIN-SUFFIX,apm-native.xiaohongshu.com,REJECT-DROP
DOMAIN-SUFFIX,sns-video-hs.xhscdn.com,REJECT-DROP
URL-REGEX,^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/metrics_report$,REJECT-DROP
URL-REGEX,^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/videofeed\/exit$,REJECT-DROP
DOMAIN-SUFFIX,sns-video-hw.xhscdn.net
DOMAIN-KEYWORD,sns-video-al.xhscdn.com
DOMAIN-SUFFIX,sns-video-qc.xhscdn.com
DOMAIN-SUFFIX,sns-video-hw.xhscdn.com
DOMAIN-SUFFIX,sns-video-bd.xhscdn.com
DOMAIN-KEYWORD,spider-tracker.xiaohongshu.com

